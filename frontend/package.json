{
  "name": "npc-gui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
